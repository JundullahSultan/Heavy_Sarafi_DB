PORT=5000
MONGODB_URI=mongodb://localhost:27017/heavy_sarafi

# Firebase Config
# Copy your Firebase Service Account JSON credentials into a file under /server, e.g. firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ImageKit Config (Get your keys from https://imagekit.io/dashboard)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
